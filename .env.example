PERSONAL_CONTEXT_MCP_TOKEN=replace-with-a-long-random-token
HOST_PORT=8000
DATABASE__PATH=./data/context.db
EMBEDDING__PROVIDER=Hash
EMBEDDING__MODEL=sha256-hash-v1
EMBEDDING__DIMENSION=128
EMBEDDING__FALLBACKTOHASH=true
EMBEDDING__TIMEOUTSECONDS=10
EMBEDDING__OLLAMA__ENDPOINT=
EMBEDDING__OLLAMA__APIKEY=
SQLITEVEC__ENABLED=true
SQLITEVEC__REQUIRED=false
AUTH__MODE=BearerToken
